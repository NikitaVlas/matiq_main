NODE_ENV=development
DATABASE_URL=postgresql://matiq:matiq_local@localhost:5432/matiq?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9100
S3_REGION=eu-central-1
S3_BUCKET=matiq-local
S3_ACCESS_KEY=matiq
S3_SECRET_KEY=matiq-local-only
USER_API_PORT=4000
ADMIN_API_PORT=4001
WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
MFA_ENCRYPTION_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=matiq_session
EMAIL_PROVIDER=console
