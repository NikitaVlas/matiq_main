NODE_ENV=development
DATABASE_URL=postgresql://matiq:matiq_local@localhost:5432/matiq?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9100
S3_REGION=eu-central-1
S3_BUCKET=matiq-local
S3_ACCESS_KEY=matiq
S3_SECRET_KEY=matiq-local-only
USER_API_PORT=4000
ADMIN_API_PORT=4001
WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
MFA_ENCRYPTION_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=matiq_session
ADMIN_SESSION_COOKIE_NAME=matiq_admin_session
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
EMAIL_PROVIDER=console
# Required in production: base64-encoded 32-byte key shared by API and Worker.
EMAIL_ENCRYPTION_KEY=
ACCOUNT_EXPORT_ENCRYPTION_KEY=
WORKER_OBSERVABILITY_PORT=9464
# Retention cleanup cadence; minimum accepted value is 60000 ms.
RETENTION_INTERVAL_MS=86400000
