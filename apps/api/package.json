{
  "name": "@matiq/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/password.test.ts test/app-module.smoke.test.ts",
    "test:integration": "vitest run test/vertical.integration.test.ts",
