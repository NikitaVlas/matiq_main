generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ATHLETE
  TRAINER
  EDITOR
  ADMIN
}

enum Discipline {
  BJJ_GI
  NO_GI_GRAPPLING
}

enum Belt {
  WHITE
  BLUE
  PURPLE
  BROWN
  BLACK
}

enum AthleteGoal {
  GENERAL_DEVELOPMENT
  COMPETITION
  RETURN_AFTER_BREAK
}

enum AssessmentContext {
  STANDING
  TOP
  BOTTOM
}

enum RoadmapItemType {
  POSITION
  SKILL_GROUP
  TECHNIQUE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELED
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  role                    UserRole                 @default(ATHLETE)
  emailVerifiedAt         DateTime?
  deletionRequestedAt     DateTime?
  deletedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  sessions                Session[]
  videoWatches            VideoWatch[]
  subscriptions           Subscription[]
  athleteProfile          AthleteProfile?
  assessment              Assessment?
  deletionRequest         AccountDeletionRequest?
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  reauthenticatedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AthleteProfile {
  id                      String        @id @default(cuid())
  userId                  String        @unique
  disciplines             Discipline[]
  belt                    Belt?
  experienceYears         Int
  trainingSessionsPerWeek Int
  competitionExperience   Boolean
  goals                   AthleteGoal[]
  completedAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapItems            RoadmapItem[]
}

model Assessment {
  id          String               @id @default(cuid())
  userId      String               @unique
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses   AssessmentResponse[]
  scores      SkillScore[]
}

model AssessmentQuestion {
  id          String               @id @default(cuid())
  key         String               @unique
  text        String
  context     AssessmentContext
  skillKey    String
  options     Json
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  responses   AssessmentResponse[]
}

model AssessmentResponse {
  id           String             @id @default(cuid())
  assessmentId String
  questionId   String
  optionKey    String
  value        Int
  createdAt    DateTime           @default(now())
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, questionId])
}

model SkillScore {
  id           String     @id @default(cuid())
  assessmentId String
  skillKey     String
  score        Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, skillKey])
}

model RoadmapItem {
  id              String          @id @default(cuid())
  athleteProfileId String
  type            RoadmapItemType
  title           String
  context         AssessmentContext?
  skillKey        String?
  position        Int
  isAddedByUser   Boolean         @default(false)
  isHidden        Boolean         @default(false)
  athleteProfile  AthleteProfile  @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  @@index([athleteProfileId, position])
}

model GameArea {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  discipline  Discipline
  positions   Position[]
}

model Position {
  id          String       @id @default(cuid())
  gameAreaId  String
  key         String
  name        String
  context     AssessmentContext
  gameArea    GameArea     @relation(fields: [gameAreaId], references: [id], onDelete: Cascade)
  skillGroups SkillGroup[]
  flows       Flow[]
  videos      Video[]
  @@unique([gameAreaId, key])
}

model SkillGroup {
  id          String      @id @default(cuid())
  positionId  String
  key         String
  name        String
  position    Position    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  techniques  Technique[]
  @@unique([positionId, key])
}

model Technique {
  id           String             @id @default(cuid())
  skillGroupId String
  key          String             @unique
  name         String
  skillGroup   SkillGroup         @relation(fields: [skillGroupId], references: [id], onDelete: Cascade)
  variants     TechniqueVariant[]
  videos       Video[]
  drills       Drill[]
}

model TechniqueVariant {
  id          String     @id @default(cuid())
  techniqueId String
  discipline  Discipline
  name        String
  technique   Technique  @relation(fields: [techniqueId], references: [id], onDelete: Cascade)
  videos      Video[]
  @@unique([techniqueId, discipline])
}

model Movement {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  videos      Video[]
  drills      Drill[]
}

model Drill {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String?
  techniqueId String?
  movementId  String?
  technique   Technique? @relation(fields: [techniqueId], references: [id], onDelete: SetNull)
  movement    Movement?  @relation(fields: [movementId], references: [id], onDelete: SetNull)
  videos      Video[]
}

model Flow {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  discipline  Discipline
  positionId  String?
  position    Position?  @relation(fields: [positionId], references: [id], onDelete: SetNull)
}

model Video {
  id            String             @id @default(cuid())
  title         String
  description   String?
  storageKey    String
  published     Boolean            @default(false)
  durationSec   Int?
  positionId    String?
  techniqueId   String?
  variantId     String?
  movementId    String?
  drillId       String?
  position      Position?          @relation(fields: [positionId], references: [id], onDelete: SetNull)
  technique     Technique?         @relation(fields: [techniqueId], references: [id], onDelete: SetNull)
  variant       TechniqueVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  movement      Movement?          @relation(fields: [movementId], references: [id], onDelete: SetNull)
  drill         Drill?             @relation(fields: [drillId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  watchEvents    VideoWatch[]
}

model VideoWatch {
  id             String   @id @default(cuid())
  videoId        String
  userId         String
  watchedSeconds Int      @default(0)
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([videoId, userId])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  status    SubscriptionStatus
  startsAt  DateTime           @default(now())
  endsAt    DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, endsAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  actor     String
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([entity, createdAt])
}

model AccountDeletionRequest {
  id          String   @id @default(cuid())
  userId      String   @unique
  requestedAt DateTime @default(now())
  completedAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
