generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ATHLETE
  TRAINER
  EDITOR
  ADMIN
}

enum Discipline {
  BJJ_GI
  NO_GI_GRAPPLING
}

enum Belt {
  WHITE
  BLUE
  PURPLE
  BROWN
  BLACK
}

enum AthleteGoal {
  GENERAL_DEVELOPMENT
  COMPETITION
  RETURN_AFTER_BREAK
}

enum AssessmentContext {
  STANDING
  TOP
  BOTTOM
}

enum RoadmapItemType {
  POSITION
  SKILL_GROUP
  TECHNIQUE
}

enum AssessmentQuestionKind {
  CONFIDENCE
  PREFERENCE
  GOAL
}

enum AssessmentMappingStatus {
  MAPPED
  UNMAPPED
}

enum AssessmentAttemptStatus {
  DRAFT
  COMPLETED
}

enum AssessmentConfidence {
  SUFFICIENT
  INSUFFICIENT_DATA
}

enum RoadmapRecommendationType {
  CORE
  GAP
  EXPLORE
}

enum RoadmapItemSource {
  ASSESSMENT
  FOUNDATION
  MANUAL
}

enum LessonRelationType {
  PRIMARY
  BRANCH
}

enum SubscriptionStatus {
  TRIAL
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCEL_AT_PERIOD_END
  EXPIRED
  CANCELED
}

enum PlaybackMode {
  FULL
  PREVIEW
}

enum PlaybackSessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
  REVOKED
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  role                    UserRole                 @default(ATHLETE)
  emailVerifiedAt         DateTime?
  deletionRequestedAt     DateTime?
  deletedAt               DateTime?
  mfaSecretEncrypted      String?
  mfaEnabledAt            DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]
  videoWatches            VideoWatch[]
  subscriptions           Subscription[]
  athleteProfile          AthleteProfile?
  assessment              Assessment?
  assessmentAttempts      AssessmentAttempt[]
  playbackSessions        PlaybackSession[]
  trainerProfile          TrainerProfile?
  authoredCourses         Course[]                 @relation("CourseTrainer")
  authoredVideos          Video[]                  @relation("VideoTrainer")
  deletionRequest         AccountDeletionRequest?
  recoveryCodes           MfaRecoveryCode[]
}

model AssessmentAttempt {
  id                   String                    @id @default(cuid())
  userId               String
  discipline           Discipline
  questionBankVersion  Int                       @default(1)
  questionBankSnapshot Json
  status               AssessmentAttemptStatus   @default(DRAFT)
  completedAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers              AssessmentAttemptAnswer[]
  evaluations          AssessmentEvaluation[]

  @@index([userId, discipline, status])
}

model AssessmentAttemptAnswer {
  id          String            @id @default(cuid())
  attemptId   String
  questionKey String
  optionKey   String?
  customText  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  attempt     AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionKey, optionKey])
}

model AssessmentEvaluation {
  id         String               @id @default(cuid())
  attemptId  String
  skillKey   String
  score      Int?
  confidence AssessmentConfidence
  reasons    Json
  createdAt  DateTime             @default(now())
  attempt    AssessmentAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, skillKey])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Session {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  userId            String
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  reauthenticatedAt DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AthleteProfile {
  id                      String        @id @default(cuid())
  userId                  String        @unique
  disciplines             Discipline[]
  belt                    Belt?
  experienceYears         Int
  experienceMonths        Int?
  trainingSessionsPerWeek Int
  competitionExperience   Boolean
  goals                   AthleteGoal[]
  completedAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapItems            RoadmapItem[]
}

model Assessment {
  id          String               @id @default(cuid())
  userId      String               @unique
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses   AssessmentResponse[]
  scores      SkillScore[]
}

model AssessmentQuestion {
  id          String                 @id @default(cuid())
  key         String                 @unique
  text        String
  context     AssessmentContext
  skillKey    String
  kind        AssessmentQuestionKind @default(CONFIDENCE)
  multiple    Boolean                @default(false)
  allowCustom Boolean                @default(false)
  options     Json
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  responses   AssessmentResponse[]
}

model AssessmentResponse {
  id             String                  @id @default(cuid())
  assessmentId   String
  questionId     String
  optionKey      String
  value          Int
  customText     String?
  mappedSkillKey String?
  mappingStatus  AssessmentMappingStatus @default(MAPPED)
  createdAt      DateTime                @default(now())
  assessment     Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question       AssessmentQuestion      @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, questionId, optionKey])
}

model SkillScore {
  id           String     @id @default(cuid())
  assessmentId String
  skillKey     String
  score        Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, skillKey])
}

model RoadmapItem {
  id                 String                    @id @default(cuid())
  athleteProfileId   String
  type               RoadmapItemType
  discipline         Discipline
  title              String
  context            AssessmentContext?
  skillKey           String?
  position           Int
  isAddedByUser      Boolean                   @default(false)
  isHidden           Boolean                   @default(false)
  lessonId           String?
  completedAt        DateTime?
  recommendationType RoadmapRecommendationType @default(GAP)
  reason             Json                      @default("{}")
  source             RoadmapItemSource         @default(ASSESSMENT)
  foundationStepId   String?
  athleteProfile     AthleteProfile            @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  lesson         Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  foundationStep FoundationStep? @relation(fields: [foundationStepId], references: [id], onDelete: SetNull)

  @@unique([athleteProfileId, foundationStepId])
  @@index([athleteProfileId, discipline, completedAt, position])
}

model FoundationTemplate {
  id                  String           @id @default(cuid())
  key                 String           @unique
  name                String
  discipline          Discipline
  belt                Belt             @default(WHITE)
  minExperienceMonths Int              @default(0)
  maxExperienceMonths Int              @default(6)
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  steps               FoundationStep[]
}

model FoundationStep {
  id           String             @id @default(cuid())
  templateId   String
  key          String
  title        String
  description  String?
  skillKey     String
  position     Int
  active       Boolean            @default(true)
  template     FoundationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  roadmapItems RoadmapItem[]

  @@unique([templateId, key])
  @@index([templateId, active, position])
}

model GameArea {
  id         String     @id @default(cuid())
  key        String     @unique
  name       String
  discipline Discipline
  positions  Position[]
}

model Position {
  id          String            @id @default(cuid())
  gameAreaId  String
  key         String
  name        String
  context     AssessmentContext
  gameArea    GameArea          @relation(fields: [gameAreaId], references: [id], onDelete: Cascade)
  skillGroups SkillGroup[]
  flows       Flow[]
  videos      Video[]

  @@unique([gameAreaId, key])
}

model SkillGroup {
  id         String      @id @default(cuid())
  positionId String
  key        String
  name       String
  position   Position    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  techniques Technique[]

  @@unique([positionId, key])
}

model Technique {
  id           String             @id @default(cuid())
  skillGroupId String
  key          String             @unique
  name         String
  skillGroup   SkillGroup         @relation(fields: [skillGroupId], references: [id], onDelete: Cascade)
  variants     TechniqueVariant[]
  videos       Video[]
  drills       Drill[]
}

model TechniqueVariant {
  id          String     @id @default(cuid())
  techniqueId String
  discipline  Discipline
  name        String
  technique   Technique  @relation(fields: [techniqueId], references: [id], onDelete: Cascade)
  videos      Video[]

  @@unique([techniqueId, discipline])
}

model Movement {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  videos      Video[]
  drills      Drill[]
}

model Drill {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String?
  techniqueId String?
  movementId  String?
  technique   Technique? @relation(fields: [techniqueId], references: [id], onDelete: SetNull)
  movement    Movement?  @relation(fields: [movementId], references: [id], onDelete: SetNull)
  videos      Video[]
}

model Flow {
  id         String     @id @default(cuid())
  key        String     @unique
  name       String
  discipline Discipline
  positionId String?
  position   Position?  @relation(fields: [positionId], references: [id], onDelete: SetNull)
}

model Video {
  id               String                @id @default(cuid())
  title            String
  description      String?
  storageKey       String
  published        Boolean               @default(false)
  durationSec      Int?
  previewStartSec  Int?
  previewEndSec    Int?
  positionId       String?
  techniqueId      String?
  variantId        String?
  movementId       String?
  drillId          String?
  trainerId        String?
  position         Position?             @relation(fields: [positionId], references: [id], onDelete: SetNull)
  technique        Technique?            @relation(fields: [techniqueId], references: [id], onDelete: SetNull)
  variant          TechniqueVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  movement         Movement?             @relation(fields: [movementId], references: [id], onDelete: SetNull)
  drill            Drill?                @relation(fields: [drillId], references: [id], onDelete: SetNull)
  trainer          User?                 @relation("VideoTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  watchEvents      VideoWatch[]
  playbackSessions PlaybackSession[]
  revisions        VideoRevision[]
  metadataValues   VideoMetadataOption[]
  Lesson           Lesson?

  @@index([trainerId])
}

model TrainerProfile {
  id                    String       @id @default(cuid())
  userId                String       @unique
  slug                  String       @unique
  displayName           String
  photoUrl              String?
  biography             String
  athleteJourney        String
  disciplines           Discipline[]
  belt                  Belt?
  qualifications        String[]
  achievements          String[]
  competitionExperience String?
  trainingPrinciples    String
  city                  String
  countryCode           String       @default("DE")
  languages             String[]
  localAvailability     String?
  socialLinks           Json         @default("[]")
  published             Boolean      @default(false)
  publishedAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlaybackSession {
  id                  String                @id @default(cuid())
  userId              String
  videoId             String
  mode                PlaybackMode          @default(FULL)
  status              PlaybackSessionStatus @default(ACTIVE)
  tokenHash           String                @unique
  watermarkId         String
  expiresAt           DateTime
  lastHeartbeatAt     DateTime?
  lastSequence        Int                   @default(0)
  creditedPositionSec Int                   @default(0)
  createdAt           DateTime              @default(now())
  closedAt            DateTime?
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video               Video                 @relation(fields: [videoId], references: [id], onDelete: Cascade)
  heartbeats          PlaybackHeartbeat[]

  @@index([userId, mode, status])
  @@index([videoId, createdAt])
}

model PlaybackHeartbeat {
  id                  String          @id @default(cuid())
  sessionId           String
  idempotencyKey      String
  sequence            Int
  previousPositionSec Float
  currentPositionSec  Float
  activePlaybackMs    Int
  playbackRate        Float
  visible             Boolean
  active              Boolean
  clientAt            DateTime
  receivedAt          DateTime        @default(now())
  accepted            Boolean
  creditedPositionSec Int
  rejectionReason     String?
  session             PlaybackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@unique([sessionId, sequence])
  @@index([sessionId, receivedAt])
}

model MetadataField {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  createdAt DateTime         @default(now())
  options   MetadataOption[]
}

model MetadataOption {
  id        String                @id @default(cuid())
  fieldId   String
  key       String
  name      String
  createdAt DateTime              @default(now())
  field     MetadataField         @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  videos    VideoMetadataOption[]

  @@unique([fieldId, key])
}

model VideoMetadataOption {
  videoId  String
  optionId String
  video    Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  option   MetadataOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([videoId, optionId])
}

model Course {
  id          String         @id @default(cuid())
  key         String         @unique
  title       String
  description String?
  discipline  Discipline
  trainerId   String?
  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  modules     CourseModule[]
  trainer     User?          @relation("CourseTrainer", fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([trainerId])
}

model CourseModule {
  id       String   @id @default(cuid())
  courseId String
  key      String
  title    String
  position Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@unique([courseId, key])
  @@index([courseId, position])
}

model Lesson {
  id                String           @id @default(cuid())
  moduleId          String
  videoId           String           @unique
  key               String
  title             String
  goal              String?
  startingPosition  String?
  endingPosition    String?
  level             String?
  giNoGi            String?
  reactions         String[]
  position          Int
  published         Boolean          @default(false)
  module            CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  video             Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)
  outgoingRelations LessonRelation[] @relation("LessonRelationFrom")
  incomingRelations LessonRelation[] @relation("LessonRelationTo")
  RoadmapItem       RoadmapItem[]

  @@unique([moduleId, key])
  @@index([moduleId, position])
}

model LessonRelation {
  id           String             @id @default(cuid())
  fromLessonId String
  toLessonId   String
  type         LessonRelationType
  triggerId    String?
  condition    String?
  position     Int                @default(0)
  fromLesson   Lesson             @relation("LessonRelationFrom", fields: [fromLessonId], references: [id], onDelete: Cascade)
  toLesson     Lesson             @relation("LessonRelationTo", fields: [toLessonId], references: [id], onDelete: Cascade)
  trigger      BranchTrigger?     @relation(fields: [triggerId], references: [id], onDelete: SetNull)

  @@unique([fromLessonId, toLessonId, type, triggerId])
  @@index([fromLessonId, type, position])
}

model BranchTrigger {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  createdAt DateTime         @default(now())
  relations LessonRelation[]
}

model VideoRevision {
  id          String    @id @default(cuid())
  videoId     String
  title       String
  description String?
  createdBy   String
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, approvedAt])
}

model VideoWatch {
  id             String   @id @default(cuid())
  videoId        String
  userId         String
  watchedSeconds Int      @default(0)
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  status                 SubscriptionStatus
  startsAt               DateTime           @default(now())
  endsAt                 DateTime
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  providerSubscriptionId String?            @unique
  providerCustomerId     String?
  cancelAtPeriodEnd      Boolean            @default(false)
  graceEndsAt            DateTime?
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, endsAt])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  providerEventId String    @unique
  eventType       String
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  payload         Json
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  actor     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}

model AccountDeletionRequest {
  id          String    @id @default(cuid())
  userId      String    @unique
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}
