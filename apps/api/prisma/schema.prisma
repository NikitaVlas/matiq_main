generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ATHLETE
  TRAINER
  EDITOR
  ADMIN
}

enum Discipline {
  BJJ_GI
  NO_GI_GRAPPLING
}

enum Belt {
  WHITE
  BLUE
  PURPLE
  BROWN
  BLACK
}

enum AthleteGoal {
  GENERAL_DEVELOPMENT
  COMPETITION
  RETURN_AFTER_BREAK
}

enum AssessmentContext {
  STANDING
  TOP
  BOTTOM
}

enum RoadmapItemType {
  POSITION
  SKILL_GROUP
  TECHNIQUE
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  role                    UserRole                 @default(ATHLETE)
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  sessions                Session[]
  athleteProfile          AthleteProfile?
  assessment              Assessment?
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AthleteProfile {
  id                      String        @id @default(cuid())
  userId                  String        @unique
  disciplines             Discipline[]
  belt                    Belt?
  experienceYears         Int
  trainingSessionsPerWeek Int
  competitionExperience   Boolean
  goals                   AthleteGoal[]
  completedAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapItems            RoadmapItem[]
}

model Assessment {
  id          String               @id @default(cuid())
  userId      String               @unique
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses   AssessmentResponse[]
  scores      SkillScore[]
}

model AssessmentQuestion {
  id          String               @id @default(cuid())
  key         String               @unique
  text        String
  context     AssessmentContext
  skillKey    String
  options     Json
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  responses   AssessmentResponse[]
}

model AssessmentResponse {
  id           String             @id @default(cuid())
  assessmentId String
  questionId   String
  optionKey    String
  value        Int
  createdAt    DateTime           @default(now())
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, questionId])
}

model SkillScore {
  id           String     @id @default(cuid())
  assessmentId String
  skillKey     String
  score        Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, skillKey])
}

model RoadmapItem {
  id              String          @id @default(cuid())
  athleteProfileId String
  type            RoadmapItemType
  title           String
  context         AssessmentContext?
  skillKey        String?
  position        Int
  isAddedByUser   Boolean         @default(false)
  isHidden        Boolean         @default(false)
  athleteProfile  AthleteProfile  @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  @@index([athleteProfileId, position])
}
